 "faq": [
  {
   "id": "f1",
   "q": "شحال كيدير الوقت باش يوجد الموقع؟",
   "a": "من 7 حتى 14 يوماً حسب النوع: صفحة الهبوط 7 أيام، الموقع التعريفي 10 أيام، والمتجر الإلكتروني 14 يوماً.",
   "hidden": false
  },
  {
   "id": "f2",
   "q": "واش كتخدمو مع مشاريع خارج طنجة؟",
   "a": "نعم — كنخدمو مع مشاريع في المغرب كامل وعن بعد: التواصل والمتابعة كيكونو عبر واتساب ومكالمات، والتسليم بنفس الطريقة المنظمة.",
   "hidden": false
  },
  {
   "id": "f3",
   "q": "واش تقدرو تعاودو تصميم موقع موجود؟",
   "a": "نعم — خدمة «تحسين موقع موجود» كتشمل إعادة تصميم عصرية كاملة، تحسين السرعة وتجربة الهاتف، وتحسين الظهور في Google.",
   "hidden": false
  },
  {
   "id": "f4",
   "q": "واش كتوفرو المحتوى والصور؟",
   "a": "كنعاونوك في تنظيم المحتوى واختيار الصور المناسبة، وكنوجّهو بالضبط شنو نحتاجو منك (نصوص، صور، أثمنة) باش الموقع يوجد بسرعة وبلا تعطيل.",
   "hidden": false
  },
  {
   "id": "f5",
   "q": "واش الموقع بالعربية والفرنسية؟",
   "a": "بجوج — كنصايبو الموقع باللغة اللي كتناسب زبنائك: العربية، الفرنسية، ولا نسختين مع بعض.",
   "hidden": false
  },
  {
   "id": "f6",
   "q": "واش المتجر كيدعم واتساب والدفع الإلكتروني؟",
   "a": "نعم — الطلب عبر واتساب هو الأساس في متاجرنا حيت هو اللي خدام مزيان في المغرب، وكنربطو حتى وسائل الدفع الإلكتروني المتاحة إضافة للدفع عند الاستلام.",
   "hidden": false
  },
  {
   "id": "f7",
   "q": "شكون كيخلص الدومين والاستضافة؟",
   "a": "الاستضافة الأساسية مشمولة في الثمن. الدومين (اسم النطاق) كيكون على العميل وكيبقى ملكو: حوالي 100–150 درهم في السنة، وكنعاونوك في اختيارو وربطو.",
   "hidden": false
  },
  {
   "id": "f8",
   "q": "واش نقدر نسير الموقع بنفسي من بعد الإطلاق؟",
   "a": "نعم — كتحصل على تكوين على الاستعمال عند التسليم، وزيد 30 يوم دعم مجاني: إصلاحات، تعديلات بسيطة، وأي سؤال عندك.",
   "hidden": false
  },
  {
   "id": "f9",
   "q": "كيفاش كنخلص؟",
   "a": "بكل بساطة: 50% عند بداية العمل و50% بعد التسليم — بلا ما تخلص الباقي حتى تشوف الموقع حي ويعجبك.",
   "hidden": false
  },
  {
   "id": "f10",
   "q": "كيفاش كنبداو مشروع؟",
   "a": "عمر استمارة «طلب عرض ثمن» أو صيفط لينا في واتساب فكرة المشروع — وغادي نجاوبوك في نفس اليوم بأسئلة دقيقة ثم عرض ثمن واضح ومكتوب، بلا التزام.",
   "hidden": false
  },
  {
   "id": "f11",
   "q": "واش الدومين والموقع كيبقاو ديالي؟",
   "a": "إيه، بالكامل. الدومين كيتسجّل باسمك وعلى حسابك (حوالي 100-150 درهم/سنة)، وبعد تسديد ثمن المشروع كاملاً ملفات موقعك ومحتواه كيبقاو ملكاً ليك — تقدر تنقلهم لأي استضافة أخرى في أي وقت.",
   "hidden": false
  },
  {
   "id": "f12",
   "q": "ما عنديش النصوص والصور واجدين، شنو نعمل؟",
   "a": "نقدرو نبداو باللي عندك، وحساب مدة التسليم كيبدا من نهار يكتمل المحتوى. إلا بغيتينا نعتنيو بكتابة المحتوى أو التصوير، هادي خدمات إضافية كنحسبوها باتفاق منفصل قبل ما نبداو.",
   "hidden": false
  }
 ]
}